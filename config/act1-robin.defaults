# ACT1-ROBIN product build defaults (ESP32-S3)
# Edit this file — not menuconfig — for board-wide firmware options.
# Applied automatically on idf.py build (see CMakeLists.txt SDKCONFIG_DEFAULTS).
# Pin map also documented in main/include/board.h
#
# Runtime network (DHCP, IP, mask, gateway, port): OLED menu F7.4 → NVS, not here.

CONFIG_IDF_TARGET="esp32s3"

# Set y only for W5500-only SPI debug (no ADS1235)
CONFIG_ACT1_SKIP_ADC=n
CONFIG_ACT1_ETH_PHY_MONITOR=n
CONFIG_ACT1_RS485_BENCH_HEARTBEAT=n
CONFIG_ACT1_CAN_BENCH_BEACON=n
CONFIG_ACT1_DOUT_BENCH_TOGGLE=n
CONFIG_ACT1_DI_BENCH_LOG=y

# --- Console (COM17 USB-UART + optional USB-JTAG mirror) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- Ethernet: W5500 on SPI2 (shared with ADS1235) ---
# All GPIO numbers = schematic IOxx / ESP-IDF GPIO_NUM_xx (NOT WROOM module pad #).
# MOSI=IO11 MISO=IO13 SCLK=IO12 | W5500 CS=IO10 INT=IO9 RST=IO46 | ADC CS=IO3 DRDY=IO8
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

CONFIG_EXAMPLE_USE_INTERNAL_ETHERNET=n
CONFIG_EXAMPLE_USE_SPI_ETHERNET=y
CONFIG_EXAMPLE_USE_W5500=y
CONFIG_EXAMPLE_SPI_ETHERNETS_NUM=1
CONFIG_EXAMPLE_ETH_SPI_HOST=1
CONFIG_EXAMPLE_ETH_SPI_SCLK_GPIO=12
CONFIG_EXAMPLE_ETH_SPI_MOSI_GPIO=11
CONFIG_EXAMPLE_ETH_SPI_MISO_GPIO=13
CONFIG_EXAMPLE_ETH_SPI_CS0_GPIO=10
CONFIG_EXAMPLE_ETH_SPI_INT0_GPIO=9
CONFIG_EXAMPLE_ETH_SPI_PHY_RST0_GPIO=46
CONFIG_EXAMPLE_ETH_SPI_CLOCK_MHZ=20

# --- Wi-Fi SoftAP (ACT1-Setup) — optional; shares RF with SPI eth on S3 ---
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_COEX_EXTERNAL_COEXIST_ENABLE=y
